{
        "version": "0.2.0",
        "configurations": [
        {
            "name": "C++: compilar para depuración",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}/${fileBasenameNoExtension}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "C++: compilar para depuración",
            "setupCommands": [
                {
                    "description": "Habilitar la visualización de estructuras STL",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}