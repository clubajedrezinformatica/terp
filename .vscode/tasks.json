{
    "version": "2.0.0",
    "tasks":[
        {
            "label": "C++: compilar archivo activo",
            "type": "process",
            "command": "/usr/bin/g++",
            "args": [
                "-std=c++17",
                "-g",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
        "options": {
            "cwd": "${fileDirname}"
        },
        "problemMatcher": [
            "$gcc"
        ],
        "group": {
            "kind": "build",
            "isDefault": true
        },
        "presentation": {
            "reveal": "always",
            "panel": "shared",
            "clear": true,
            "focus": false
        }
    },
    {
        "label": "C++: compilar y ejecutar archivo activo",
        "type": "process",
        "command": "/bin/bash",
        "args": ["-lc", "/usr/bin/g++ -std=c++17 -O2 -Wall -Wextra -Wpedantic ${file} -o ${fileDirname}/${fileBasenameNoExtension} && ${fileDirname}/${fileBasenameNoExtension}"],
        "options": {
            "cwd": "${fileDirname}",
        },
        "problemMatcher": [
            "$gcc"
        ],
        "presentation": {
            "reveal": "always",
            "panel": "dedicated",
            "clear": true,
            "focus": true 
        }
    },
    {
        "label": "C++: compilar para depuración",
        "type": "process",
        "command": "/usr/bin/g++",
        "args": [
            "-std=c++17",
            "-g",
            "-O0",
            "-Wall",
            "-Wextra",
            "-Wpedantic",
            "${file}",
            "-o",
            "${fileDirname}/${fileBasenameNoExtension}"
        ],
        "options": {
            "cwd": "${fileDirname}"
        },
        "problemMatcher": [
            "$gcc"
        ],
        "presentation": {
            "reveal": "always",
            "panel": "shared",
            "clear": true,
            "focus": false
        }
    }
   ]
}